# GitHub Repository Ingestion
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=pallets/flask

# Neo4j Aura Graph Database (bolt+TLS)
NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── LLM Provider Configuration ─────────────────────────────────────
# Options: "sarvam" (recommended) or "openai_compatible"
LLM_PROVIDER=sarvam

# ── Sarvam AI Configuration ────────────────────────────────────────
# Get your API key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

# ── Token Optimization & Rate Limiting ─────────────────────────────
MAX_INPUT_TOKENS=4000
MAX_OUTPUT_TOKENS=1000
MAX_HISTORY_MESSAGES=6
MAX_RETRIEVED_CHUNKS=5
DAILY_REQUEST_LIMIT=20

# ── Legacy OpenAI-Compatible LLM (used when LLM_PROVIDER=openai_compatible) ──
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-2.0-flash

# Optional Vector Embeddings
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Pipeline & Evaluation Flags
EXTRACTION_MODE=curated
# EXPOSE_GOLDEN_QUESTIONS gates GET /golden-questions to prevent evaluation benchmark memorization
EXPOSE_GOLDEN_QUESTIONS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
